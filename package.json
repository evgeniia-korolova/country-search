{
    "name": "country-search",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc -p tsconfig.test.json",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,mjs,ts}": [
            "eslint",
            "prettier --check"
        ],
        "*.{json,md,scss,css,html}": [
            "prettier --check"
        ]
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/evgeniia-korolova/country-search.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/evgeniia-korolova/country-search/issues"
    },
    "homepage": "https://github.com/evgeniia-korolova/country-search#readme",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "prettier": "^3.10.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2",
        "vitest": "^5.1.0"
    }
}
