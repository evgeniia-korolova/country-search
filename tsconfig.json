{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "Bundler",

        "lib": ["DOM", "DOM.Iterable", "ES2023"],

        "rootDir": "./src",
        "outDir": "./dist",

        "strict": true,
        "noImplicitOverride": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmitOnError": true,
        "sourceMap": true,
        "verbatimModuleSyntax": true
    },
    "include": ["src"]
}
